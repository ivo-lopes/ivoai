diff --git a/packages/opencode/src/plugin/ivoai-managed.ts b/packages/opencode/src/plugin/ivoai-managed.ts
new file mode 100644
index 0000000..f85e55f
--- /dev/null
+++ b/packages/opencode/src/plugin/ivoai-managed.ts
@@ -0,0 +1,31 @@
+// Reviewed IVOAI managed entrypoints use only host-bundled runtime modules.
+// This opt-in is set by the private IVOAI launcher, never a project config.
+import fs from "node:fs/promises"
+import path from "node:path"
+import { fileURLToPath } from "node:url"
+import { Flag } from "@opencode-ai/core/flag/flag"
+
+export async function assertIvoaiManagedPlugin(spec: string, kind: "server" | "tui") {
+  if (!Flag.IVOAI_MANAGED_LOCAL_PLUGINS) return
+  const denied = () => new Error("IVOAI_MANAGED_PLUGIN_DENIED: only the reviewed private local entrypoint is allowed")
+  const assets = process.env.IVOAI_MANAGED_ASSETS_DIR
+  if (!assets || !path.isAbsolute(assets)) throw denied()
+  let entry: string
+  try {
+    const url = new URL(spec)
+    if (url.protocol !== "file:" || url.host || url.search || url.hash) throw denied()
+    entry = fileURLToPath(url)
+  } catch {
+    throw denied()
+  }
+  const root = path.resolve(assets)
+  const expected = path.join(root, kind === "server" ? "server-plugin.mjs" : "tui-plugin.tsx")
+  if (entry !== expected) throw denied()
+  const [realRoot, realEntry, rootInfo, entryInfo] = await Promise.all([
+    fs.realpath(root), fs.realpath(entry), fs.lstat(root), fs.lstat(entry),
+  ])
+  const uid = process.getuid?.()
+  if (realRoot !== root || realEntry !== expected || !rootInfo.isDirectory() || !entryInfo.isFile() ||
+      (rootInfo.mode & 0o077) !== 0 || (entryInfo.mode & 0o077) !== 0 ||
+      uid === undefined || rootInfo.uid !== uid || entryInfo.uid !== uid) throw denied()
+}
