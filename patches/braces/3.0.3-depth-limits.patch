+'use strict';
+
+// IVOAI patch for CVE-2026-93687. Limits cannot be disabled by options.
+const fail = () => { throw new SyntaxError('braces safety limit exceeded'); };
+const validate = ast => {
+  const pending = [[ast, 0]];
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 256 || ++count > 65536) fail();
+    if (node.value !== undefined && typeof node.value !== 'string') fail();
+    let parent = node.parent;
+    let hops = 0;
+    while (parent) {
+      if (++hops > 256) fail();
+      parent = parent.parent;
+    }
+    if (node.nodes) {
+      if (node.nodes.length + pending.length + count > 65536) fail();
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { validate, fail };
