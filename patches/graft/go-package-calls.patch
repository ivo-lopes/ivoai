+/** Import-qualified Go calls only. No global-name or directory-name guessing. */
+import type Parser from "tree-sitter";
+type Node = Parser.SyntaxNode;
+export interface GoPackageCall {
+  qualifier: string;
+  imports: Array<{ specifier: string; alias: string | null }>;
+}
+const SCOPES = new Set(["source_file", "block", "if_statement", "for_statement",
+  "expression_switch_statement", "type_switch_statement", "expression_case", "type_case",
+  "communication_case", "function_declaration", "method_declaration", "func_literal"]);
+const FUNCS = new Set(["function_declaration", "method_declaration", "func_literal"]);
+export function collectGoPackages(root: Node) {
+  const imports: GoPackageCall["imports"] = [];
+  const bindings = new Map<string, Array<{ scope: number; begins: number }>>();
+  function bind(name: Node, decl: Node, parameter = false) {
+    let scope = decl.parent;
+    while (scope && !(parameter ? FUNCS : SCOPES).has(scope.type)) {
+      // Function-type argument names do not declare enclosing local variables.
+      if (parameter && scope.type === "function_type") return;
+      scope = scope.parent;
+    }
+    if (!scope) return;
+    const list = bindings.get(name.text) ?? [];
+    list.push({scope: scope.id, begins: parameter ? scope.startIndex : decl.endIndex});
+    bindings.set(name.text, list);
+  }
+  function visit(n: Node) {
+    if (n.type === "import_spec") {
+      const path = n.childForFieldName("path");
+      const alias = n.childForFieldName("name")?.text ?? null;
+      if (path && alias !== "." && alias !== "_") {
+        // Only literal import paths, never source evaluation. Reject escaped
+        // paths instead of trying to implement the Go string-literal grammar.
+        const specifier = path.text.slice(1, -1);
+        if (!specifier.includes("\\")) imports.push({specifier, alias});
+      }
+      return;
+    }
+    const parameter = n.type === "parameter_declaration" || n.type === "variadic_parameter_declaration";
+    if (parameter || ["var_spec", "const_spec", "type_spec"].includes(n.type)) {
+      n.children.forEach((child, i) => { if (n.fieldNameForChild(i) === "name") bind(child, n, parameter); });
+    }
+    if (["short_var_declaration", "range_clause", "receive_statement"].includes(n.type)
+        && n.children.some(c => c.text === ":=")) {
+      const left = n.childForFieldName("left");
+      if (left) for (const name of left.type === "identifier" ? [left] : left.namedChildren)
+        if (name.type === "identifier") bind(name, n);
+    }
+    if (n.type === "type_switch_statement") {
+      const alias = n.childForFieldName("alias");
+      for (const name of alias?.namedChildren ?? []) {
+        const list = bindings.get(name.text) ?? [];
+        list.push({scope: n.id, begins: n.childForFieldName("value")?.endIndex ?? n.startIndex});
+        bindings.set(name.text, list);
+      }
+    }
+    for (const child of n.namedChildren) visit(child);
+  }
+  if (!root.hasError) visit(root);
+  return { imports, bindings };
+}
+export function goPackageCall(node: Node, qualifier: string, state: ReturnType<typeof collectGoPackages>): GoPackageCall | undefined {
+  const scopes = new Set<number>();
+  for (let n: Node | null = node; n; n = n.parent) scopes.add(n.id);
+  if (state.bindings.get(qualifier)?.some(b => scopes.has(b.scope) && b.begins <= node.startIndex)) return;
+  const imports = state.imports.filter(i => i.alias === null || i.alias === qualifier);
+  return imports.length ? {qualifier, imports} : undefined;
+}
