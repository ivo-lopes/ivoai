  "security_contracts": {
    "read": "Only memory_read_page; exact bounded query OR path; typed Core callback and original local scope key required; no model policy or arbitrary name/endpoint/header.",
    "source": "One complete selected profile; no federation/failover, remote session, redirect or resumption. Existing Router transport/credential map/circuit reused.",
    "strict_validation": "Per-call response validator precedes recordSuccess; matching host ID, exclusive result, duplicate/trailing JSON rejection, full finite SSE, supported text-only CallToolResult, no error/partial/truncated flags, HTTP 200 and no stateful/partial headers.",
    "bounds": {
      "response_bytes": 1048576,
      "parallel_live_reads": 8,
      "json_depth": 32,
      "json_value_nodes": 8192,
      "sse_frame_slots": 64,
      "argument_bytes": 512
    },
    "snapshot": "Fresh admitted successful LIVE request always sends HTTP before a host nonce exists. Explicit reuse uses the same immutable snapshot identity; stable generation is never a live-service freshness claim.",
    "retention": "Default unknown/no artifact. Independent host grant and host classification callbacks; upstream/model annotations cannot approve Internal/Restricted. Full opaque bytes available to classifier. No institutional generic classifier supplied.",
    "TTL": "Explicit per-artifact host TTL, 1 minute through existing 7-day maximum. Legacy Request zero retains old default. Nonzero invalid TTL rejected before fetch.",
    "exact_recovery": "Protected evidence_ IDs, canonical bindings, same session/Core scope, recipient ownership, sealed SHA, original CRLF SSE bytes preserved. No legacy fallback after binding loss.",
    "completeness": "ResponseComplete only means complete accepted response framing. SourceComplete remains false; no full-page/corpus assertion.",
    "remote_revocation": "Recovery checks current local grant/retention, not current remote authorization. Remote 401 on a new LIVE request does not silently revoke locally retained data.",
    "secret_detection": "Existing known-secret admission remains an additional heuristic defense; no perfect detector or arbitrary-source safety certification.",
    "telemetry": "No query/path/body/credential in events or error messages; formatted args/snapshots hide private values. Targeted archived-log credential-pattern check is not certification."
